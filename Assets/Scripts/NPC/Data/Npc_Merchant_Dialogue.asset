  npcName: "\u65B0\u4EBA\u5411\u5BFC"
  npcPortrait: {fileID: 21300000, guid: 8fd2d0449599e4f7a9a1f1f170b6a2b0, type: 3}
  dialogueLines:
  - "\u4F60\u597D\uFF0C\u65B0\u6765\u7684\u52C7\u8005"
  - "\u6700\u8FD1\u57CE\u9547\u5468\u56F4\u7684\u602A\u7269\u975E\u5E38\u6D3B\u8DC3\uFF0C\u62DC\u6258\u4F60\u5E2E\u5FD9\u6E05\u7406\u4E00\u4E0B\u5468\u56F4\u7684\u602A\u7269"
  - "\u51FB\u6740\u602A\u7269\u4F1A\u6389\u843D\u94B1,\u94B1\u53EF\u4EE5\u627E\u54E8\u5175\u63D0\u9AD8\u4F60\u7684\u5C5E\u6027"
  - "\u540C\u65F6\u4F60\u51FB\u6740\u4E00\u4E9B\u602A\u7269\u4F1A\u5347\u7EA7\uFF0C\u5347\u7EA7\u540E\u4F60\u4F1A\u6709\u6280\u80FD\u70B9\uFF0C\u53EF\u4EE5\u53BB\u89E3\u9501\u6280\u80FD"
  - "\u52C7\u8005\uFF0C\u5F00\u59CB\u4F60\u7684\u65C5\u884C\u5427"
  triggerEventOnEnd: 0
  eventId: 0
